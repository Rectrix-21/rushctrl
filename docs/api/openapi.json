  "components": {
    "schemas": {
      "AssignmentInput": {
        "required": [
          "userId",
          "version"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "version": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AvailabilityInput": {
        "required": [
          "locationId",
          "startsAt",
          "endsAt"
        ],
        "type": "object",
        "properties": {
          "locationId": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "type": [
              "null",
              "string"
            ]
          },
          "endsAt": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "HealthStatus": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "LoginInput": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RequestInput": {
        "required": [
          "shiftId"
        ],
        "type": "object",
        "properties": {
          "shiftId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "RequirementInput": {
        "required": [
          "locationId",
          "skillId",
          "startsAt",
          "endsAt",
          "requiredCount"
        ],
        "type": "object",
        "properties": {
          "locationId": {
            "type": "string",
            "format": "uuid"
          },
          "skillId": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "type": [
              "null",
              "string"
            ]
          },
          "endsAt": {
            "type": [
              "null",
              "string"
            ]
          },
          "requiredCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ShiftInput": {
        "required": [
          "locationId",
          "skillId",
          "startsAt",
          "endsAt"
        ],
        "type": "object",
        "properties": {
          "locationId": {
            "type": "string",
            "format": "uuid"
          },
          "skillId": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "type": [
              "null",
              "string"
            ]
          },
          "endsAt": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SystemMetadata": {
        "required": [
          "name",
          "version",
          "milestone"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "milestone": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
